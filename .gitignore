dist/
.env*.local
.env
tools/portrait-extender/output/
tools/portrait-extender/.venv/
tools/portrait-extender/__pycache__/
__pycache__/
node_modules/
.playwright-cli/
_acccheck/

# Phase 2.5 — Playwright verification screenshots are reproducible from
# scripts/verify-safe-area.mjs and don't belong in the repo. The script
# itself stays checked in for future audits.
pw-verify-*.png

# Working artifacts / scratch — not source
eval/
voiceover-output/
.agents/
.playwright-mcp/
.fable/
benchmarks/traces/
.scratch/

# lang-check corpus cache (downloaded by scripts/lang-check.mjs --fetch; never committed)
.lang-check-cache/

# Accuracy-harness per-hour dumps (review/accuracy/run-eval.mjs regenerates them in ~45 s)
review/accuracy/results/*-hours.csv

# Live accuracy recorder data (review/accuracy/live/README.md) — hourly, ~2 MB/day, stays on disk
review/accuracy/live/*.jsonl
review/accuracy/live/recorder.log

# Precision check raw downloads (review/accuracy/v2/fetch.mjs re-creates them)
review/accuracy/v2/data/
