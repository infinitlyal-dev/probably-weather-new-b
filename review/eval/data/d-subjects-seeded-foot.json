   "subjectY": 465,
   "textTop": 415,
   "capBottom": 529,
   "lineTop": 535,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "Officially he’s watering the garden. The garden is third in the queue.",
   "file": "heat-b2c32c85.png"
  },
  {
   "hash": "44786fa8cca62831e864d9d98d63234a48281b97de1263d355e0d741bfabf0fa",
   "anchor": 80,
   "slot": "clear/week_1/dawn/2.webp",
   "served": true,
   "subjectY": 462,
   "textTop": 393,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "Not a breath of haze this morning; even the mountain got up early.",
   "file": "clear-44786fa8.png"
  },
  {
   "hash": "b8f8ea343b77586d191afc873309450d62dce914ec0f6c1debe6e90b46af2145",
   "anchor": 77,
   "slot": "clear/week_1/dusk/2.webp",
   "served": true,
   "subjectY": 451,
   "textTop": 393,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "The day used up every hour of light and still had this left over.",
   "file": "clear-b8f8ea34.png"
  },
  {
   "hash": "791e756ecc1d68c7cb9a600fafcda18b191fbc4fbae35c28f116b9635c2248d3",
   "anchor": 77,
   "slot": "cloudy/week_1/dusk/1.webp",
   "served": true,
   "subjectY": 451,
   "textTop": 393,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "The sky can’t decide between golden hour and going home early. Neither can anyone else.",
   "file": "cloudy-791e756e.png"
  },
  {
   "hash": "99418a1761068f4143c08dc79dad8947345efa6403bc23a8479d96ecb42a2433",
   "anchor": 77,
   "slot": "heat/week_1/night/3.webp",
   "served": true,
   "subjectY": 451,
   "textTop": 415,
   "capBottom": 529,
   "lineTop": 535,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "Tile is the coldest surface in the house tonight, and it is taken.",
   "file": "heat-99418a17.png"
  },
  {
   "hash": "e2f0a2c1d410db1f3ed66104e829371fe55f4b982c8b5ee1cada5e0752352f4b",
   "anchor": 76,
   "slot": "cold/week_1/night/1.webp",
   "served": true,
   "subjectY": 448,
   "textTop": 393,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "The cold cleared the whole street an hour before closing time.",
   "file": "cold-e2f0a2c1.png"
  },
  {
   "hash": "6e0d76c63cde82b91119b5f5853d9ada08f19557a8a5c8cce7a79c1d06331024",
   "anchor": 76,
   "slot": "cold/week_2/night/7.webp",
   "served": true,
   "subjectY": 448,
   "textTop": 431,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "No stars on offer tonight, so the city is providing its own.",
   "file": "cold-6e0d76c6.png"
  },
  {
   "hash": "7563eedc5863a72c03d73f1208b4574775e066fa9028dc678d68343df3f00abe",
   "anchor": 76,
   "slot": "cold-clear/week_1/night/4.webp",
   "served": true,
   "subjectY": 448,
   "textTop": 415,
   "capBottom": 529,
   "lineTop": 535,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "The Southern Cross is out, and so is the frost. Package deal.",
   "file": "cold-clear-7563eedc.png"
  },
  {
   "hash": "dbadc260a0fbdeff4fc15a7cb347bbacb2def1d5c4fd762e8f398863fb1a4e1b",
   "anchor": 76,
   "slot": "heat/week_1/day/4.webp",
   "served": true,
   "subjectY": 448,
   "textTop": 453,
   "capBottom": 529,
   "lineTop": 535,
   "risen": false,
   "zone": "open",
   "underJoke": false,
   "idleSyncs": 0,
   "line": "Hotter than a bakkie dashboard at noon.",
   "file": "heat-dbadc260.png"
  },
  {
   "hash": "6c75084d23dbf03a524515716593a6338b5386869ecaaee822f8f8f6daafe4f1",
   "anchor": 75,
   "slot": "cold/week_1/dusk/2.webp",
   "served": true,
   "subjectY": 444,
   "textTop": 431,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "The sun is leaving the mountains one shelf at a time.",
   "file": "cold-6c75084d.png"
  },
  {
   "hash": "4a0b5d3b10ec517285cbdd3954ca7bcc19284559273995988a60b27c2d241cda",
   "anchor": 75,
   "slot": "wind/week_1/dusk/1.webp",
   "served": true,
   "subjectY": 444,
   "textTop": 393,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "Lion's Head is doing the scenery and the wind is doing the comedy.",
   "file": "wind-4a0b5d3b.png"
  },
  {
   "hash": "6a8154f7a40144a8e3c3453e8069466dc162d8fd914bcd5f073dc547319ca73c",
   "anchor": 74,
   "slot": "clear/week_1/dawn/4.webp",
   "served": true,
   "subjectY": 441,
   "textTop": 431,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "Zero drama in the sky. Highly unusual. Gladly accepted.",
   "file": "clear-6a8154f7.png"
  },
  {
   "hash": "c7090cc8143069a1a8e66856c6a1fbe497f6cdde91daec029d05323285b8d201",
   "anchor": 74,
   "slot": "cold-clear/week_1/day/5.webp",
   "served": true,
   "subjectY": 441,
   "textTop": 453,
   "capBottom": 529,
   "lineTop": 535,
   "risen": false,
   "zone": "open",
   "underJoke": false,
   "idleSyncs": 0,
   "line": "The car coughed twice before it agreed to start.",
   "file": "cold-clear-c7090cc8.png"
  },
  {
   "hash": "12dc08356d8858edc9b684051c996f4d519977e7e0108a1924f6faebf35096c9",
   "anchor": 74,
   "slot": "heat/week_1/night/4.webp",
   "served": true,
   "subjectY": 441,
   "textTop": 415,
   "capBottom": 529,
   "lineTop": 535,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "Ice in the jug, fan on the chair: the night shift of a forty-degree day.",
   "file": "heat-12dc0835.png"
  },
  {
   "hash": "572a51d30dc5fe66a2a81e320d29a397f36c23d579c564d8e520f0682c8dea3b",
   "anchor": 73,
   "slot": "storm/week_1/dusk/5.webp",
   "served": true,
   "subjectY": 437,
   "textTop": 393,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "Somewhere up there the rain found a way in, and it is being managed.",
   "file": "storm-572a51d3.png"
  },
  {
   "hash": "16a1b557a12bd5d8b20c17f0816c52417f44300bd957faf5b5c740174f7eddbb",
   "anchor": 72,
   "slot": "cold-clear/week_1/night/6.webp",
   "served": true,
   "subjectY": 434,
   "textTop": 453,
   "capBottom": 529,
   "lineTop": 535,
   "risen": false,
   "zone": "open",
   "underJoke": false,
   "idleSyncs": 0,
   "line": "The car coughed twice before it agreed to start.",
   "file": "cold-clear-16a1b557.png"
  },
  {
   "hash": "5e8246208843fe0a835c719744d6bf49971720f5f2b6985e6839742adf8d64f3",
   "anchor": 72,
   "slot": "rain/week_1/dusk/3.webp",
   "served": true,
   "subjectY": 434,
   "textTop": 431,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "The clouds are having a moment.",
   "file": "rain-5e824620.png"
  },
  {
   "hash": "26260612a6f27ce8718acbcb329b41be199d30b98ce1ff9dd504c8a104590a05",
   "anchor": 71,
   "slot": "fog/week_1/dusk/2.webp",
   "served": true,
   "subjectY": 430,
   "textTop": 415,
   "capBottom": 529,
   "lineTop": 535,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "Every streetlamp gets its own halo tonight; the fog is generous like that.",
   "file": "fog-26260612.png"
  },
  {
   "hash": "0af3b5a8e364791761c448e994ad918b8d1a69ff13beb72b01f9fb59b5253b06",
   "anchor": 70,
   "slot": "heat/week_1/day/7.webp",
   "served": true,
   "subjectY": 427,
   "textTop": 415,
   "capBottom": 529,
   "lineTop": 535,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "The lawn is taking a beating that has nothing to do with the sun.",
   "file": "heat-0af3b5a8.png"
  },
  {
   "hash": "336f41869884bd7b62ab2c3e346f56b611c00f4c4ef109fe30b9897c1017cf55",
   "anchor": 69,
   "slot": "fog/week_1/dusk/5.webp",
   "served": true,
   "subjectY": 423,
   "textTop": 415,
   "capBottom": 529,
   "lineTop": 535,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "The fog took the city but it is not getting the Bo-Kaap's colours.",
   "file": "fog-336f4186.png"
  },
  {
   "hash": "3d5ba6fd7a8172083aa66e8f1ed007311b529a91740a3a359e005bc2a5f80405",
   "anchor": 69,
   "slot": "heat/week_1/dawn/2.webp",
   "served": true,
   "subjectY": 423,
   "textTop": 415,
   "capBottom": 529,
   "lineTop": 535,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "Funny how everyone suddenly remembers they love you when you own a pool.",
   "file": "heat-3d5ba6fd.png"
  },
  {
   "hash": "4c12a169237911506240ef8b71f61de0fe0a77888ac40c9f684c32e0ac66be03",
   "anchor": 69,
   "slot": "heat/week_1/dawn/3.webp",
   "served": true,
   "subjectY": 423,
   "textTop": 453,
   "capBottom": 529,
   "lineTop": 535,
   "risen": false,
   "zone": "open",
   "underJoke": false,
   "idleSyncs": 0,
   "line": "6:30 and the tar is already considering melting.",
   "file": "heat-4c12a169.png"
  },
  {
   "hash": "7b2ce5e4f66ef2bc28ab90f7786777af67a93ce46adb6dac8512ee09f2d530b6",
   "anchor": 69,
   "slot": "heat/week_1/dusk/3.webp",
   "served": true,
   "subjectY": 423,
   "textTop": 453,
   "capBottom": 529,
   "lineTop": 535,
   "risen": false,
   "zone": "open",
   "underJoke": false,
   "idleSyncs": 0,
   "line": "Stay hydrated or become a biltong.",
   "file": "heat-7b2ce5e4.png"
  },
  {
   "hash": "752ebaed7c7a6ecbdf3127a081fc207d1e6dea64528f9f7a017b804901d273b4",
   "anchor": 68,
   "slot": "clear/week_1/day/1.webp",
   "served": true,
   "subjectY": 420,
   "textTop": 393,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "A sky like that overrules HR, and everybody at reception knows it.",
   "file": "clear-752ebaed.png"
  },
  {
   "hash": "549601db52a8dded6c4ebedfa5c6fdaeb279c02a1b27e2a8f1f5de64431304dc",
   "anchor": 68,
   "slot": "cloudy/week_1/night/4.webp",
   "served": true,
   "subjectY": 420,
   "textTop": 393,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "Low cloud at night keeps the cold off the promenade, and the regulars know it.",
   "file": "cloudy-549601db.png"
  },
  {
   "hash": "8cc6367de3d1e1ccb2084168b423842ac75ae584dc7cc05600ff57f5867db19b",
   "anchor": 68,
   "slot": "cold-clear/week_1/night/2.webp",
   "served": true,
   "subjectY": 420,
   "textTop": 415,
   "capBottom": 529,
   "lineTop": 535,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "The bin run is being done at speed tonight, and the sky knows why.",
   "file": "cold-clear-8cc6367d.png"
  },
  {
   "hash": "b1ae5ed3f1e46c448d3f3ab4e9f8f0d03e8f223e70f837f60a63693230ed5044",
   "anchor": 68,
   "slot": "heat/week_1/day/1.webp",
   "served": true,
   "subjectY": 420,
   "textTop": 453,
   "capBottom": 529,
   "lineTop": 535,
   "risen": false,
   "zone": "open",
   "underJoke": false,
   "idleSyncs": 0,
   "line": "35 in the shade. In the sun, nobody's counting anymore.",
   "file": "heat-b1ae5ed3.png"
  },
  {
   "hash": "8cc0e2a4cb5284d07dad4ddeabe7776a0c10ae44b6de24b0204b130691d28b33",
   "anchor": 67,
   "slot": "cold/week_1/dusk/3.webp",
   "served": true,
   "subjectY": 416,
   "textTop": 393,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "Nobody's footprints on that sand today; the cold is keeping its beach to itself.",
   "file": "cold-8cc0e2a4.png"
  },
  {
   "hash": "79b25525790f0558877e3bc948e8cf147256fa648b5dba59ac0f1684317590cd",
   "anchor": 67,
   "slot": "fog/week_1/dawn/1.webp",
   "served": true,
   "subjectY": 416,
   "textTop": 415,
   "capBottom": 529,
   "lineTop": 535,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "Everything past the streetlight is a rumour until about nine.",
   "file": "fog-79b25525.png"
  },
  {
   "hash": "9864fb8df7da7089aae6e0ac771d7b02e251ed1797830bea11e1be5dfd85629d",
   "anchor": 66,
   "slot": "clear/week_1/dawn/6.webp",
   "served": true,
   "subjectY": 413,
   "textTop": 393,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "One sunrise, used twice — once in the sky and once off the wet sand.",
   "file": "clear-9864fb8d.png"
  },
  {
   "hash": "668c558784196b0c2fc19cc2ce777ba4e56cbee2708f65607b11162c90a3c472",
   "anchor": 66,
   "slot": "clear/week_1/day/7.webp",
   "served": true,
   "subjectY": 413,
   "textTop": 393,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "Grass warm, sky empty — the kind of Sunday that resets a whole family.",
   "file": "clear-668c5587.png"
  },
  {
   "hash": "22e65e5fd954acd67621cb416e7bf49990ce20082f3267d08d5b9e7362414569",
   "anchor": 66,
   "slot": "clear/week_1/night/5.webp",
   "served": true,
   "subjectY": 413,
   "textTop": 393,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "The evening is holding at exactly the temperature nobody talks about.",
   "file": "clear-22e65e5f.png"
  },
  {
   "hash": "825a6ff641243640ad29eed63e07ddcee661e6e71a2c84850a6c999b7a1e062d",
   "anchor": 66,
   "slot": "cold/week_1/day/1.webp",
   "served": true,
   "subjectY": 413,
   "textTop": 393,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "That drop has been thinking about letting go since about four this morning.",
   "file": "cold-825a6ff6.png"
  },
  {
   "hash": "9248c64fdecc1a45432aa41c045977d64504e02c95c6aab72db2800553871d3e",
   "anchor": 64,
   "slot": "wind/week_1/night/6.webp",
   "served": true,
   "subjectY": 406,
   "textTop": 393,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "Those coals are doing more for the fence than they are for the meat.",
   "file": "wind-9248c64f.png"
  },
  {
   "hash": "015fe1a72983fd52e3e589916111385aef136ae928dabd35dc4e30c00ef74461",
   "anchor": 63,
   "slot": "clear/week_1/dawn/1.webp",
   "served": true,
   "subjectY": 403,
   "textTop": 431,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "open",
   "underJoke": false,
   "idleSyncs": 0,
   "line": "The sun woke up and chose glorious.",
   "file": "clear-015fe1a7.png"
  },
  {
   "hash": "c796454299a4bc32a520ae2ebeafe6a9447f253be2261c1612164a9f1a3cbaa1",
   "anchor": 63,
   "slot": "cloudy/week_1/day/4.webp",
   "served": true,
   "subjectY": 403,
   "textTop": 431,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "open",
   "underJoke": false,
   "idleSyncs": 0,
   "line": "Bring a jacket. Or sunscreen. Or both.",
   "file": "cloudy-c7964542.png"
  },
  {
   "hash": "6d489d62f30f83f8f289d2e6360d224fe55e95cc661edc1341bc463eaf7f58cd",
   "anchor": 61,
   "slot": "clear/week_1/day/4.webp",
   "served": true,
   "subjectY": 396,
   "textTop": 393,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "The sort of afternoon that keeps a whole soccer team sitting on a curb.",
   "file": "clear-6d489d62.png"
  },
  {
   "hash": "357e2151b07dc48b5749049a908a726b9260cb088de2e3fb443a94aff07b2eb3",
   "anchor": 61,
   "slot": "clear/week_1/dusk/7.webp",
   "served": true,
   "subjectY": 396,
   "textTop": 393,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
   "underJoke": true,
   "idleSyncs": 0,
   "line": "That sky is doing its whole show over a sea too flat to interrupt it.",
   "file": "clear-357e2151.png"
  },
  {
   "hash": "ed4291a686a0287060e198542952114d5f6433a7d7a98ce2fc5d8f6aaa7ee43b",
   "anchor": 61,
   "slot": "clear/week_1/night/3.webp",
   "served": true,
   "subjectY": 396,
   "textTop": 431,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "open",
   "underJoke": false,
   "idleSyncs": 0,
   "line": "Tomorrow's weather is tomorrow's problem.",
   "file": "clear-ed4291a6.png"
  },
  {
   "hash": "a4e1da997c4aaf0a41e6e15cd91633a472adf4de0ca96ccb0660cd9ac7a82567",
   "anchor": 61,
   "slot": "cloudy/week_2/day/6.webp",
   "served": true,
   "subjectY": 396,
   "textTop": 393,
   "capBottom": 507,
   "lineTop": 513,
   "risen": false,
   "zone": "joke",
